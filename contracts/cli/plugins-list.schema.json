{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugins-list.schema.json",
  "items": {
    "properties": {
      "name": {
        "type": "string"
      },
      "kind": {
        "type": "string",
        "description": "in-process, remote, local"
      },
      "description": {
        "type": "string"
      },
      "endpoint": {
        "type": "string",
        "description": "URL or command, for external plugins"
      },
      "permissions": {
        "items": {
          "type": "string"
        },
        "type": "array",
        "description": "Permissions are what the OS must allow it before its tools can work,\nas it declares them (routines that use it need them too)."
      }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
      "name",
      "kind"
    ],
    "description": "PluginInfo is one row of `plugins list --json`."
  },
  "type": "array",
  "title": "procauto plugins list --json"
}
