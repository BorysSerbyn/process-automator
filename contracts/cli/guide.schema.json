{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guide.schema.json",
  "properties": {
    "topics": {
      "items": {
        "properties": {
          "name": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "summary"
        ],
        "description": "GuideTopic is one of the guide's topics."
      },
      "type": "array",
      "description": "Topics are the guide's topics, when no topic is given."
    },
    "topic": {
      "type": "string",
      "description": "Topic is the topic shown, with its title and sections."
    },
    "title": {
      "type": "string"
    },
    "sections": {
      "items": {
        "properties": {
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "description": "Text is the section as plain text (Markdown), its tables included."
          },
          "tables": {
            "items": {
              "properties": {
                "id": {
                  "type": "string"
                },
                "columns": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "rows": {
                  "items": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "type": "array"
                }
              },
              "additionalProperties": false,
              "type": "object",
              "required": [
                "id",
                "columns",
                "rows"
              ],
              "description": "GuideTable is a table the guide generates from code."
            },
            "type": "array",
            "description": "Tables are the section's generated tables, as data."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "text"
        ],
        "description": "GuideSection is one section of a topic."
      },
      "type": "array"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "title": "procauto guide --json",
  "description": "GuideOutput is `guide --json`: the topics (no topic given), or one topic."
}
