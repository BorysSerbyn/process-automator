{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "doctor.schema.json",
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "findings": {
      "items": {
        "properties": {
          "area": {
            "type": "string",
            "enum": [
              "scheduler",
              "usage",
              "routine",
              "hook",
              "run"
            ],
            "description": "Area is what it's about: scheduler, usage, routine, hook or run."
          },
          "subject": {
            "type": "string"
          },
          "problem": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          },
          "permission": {
            "type": "string",
            "description": "Permission is the permission it's about when one isn't granted\n(`permissions request \u003cpermission\u003e` asks the OS for it), and Open the\naddress of the OS's page that turns it on (absent when there's none)."
          },
          "open": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "area",
          "subject",
          "problem"
        ],
        "description": "Finding is one problem doctor found, with what fixes it."
      },
      "type": "array"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "ok",
    "findings"
  ],
  "title": "procauto doctor --json",
  "description": "DoctorOutput is `doctor --json`."
}
