{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "notifications.schema.json",
  "properties": {
    "schemaVersion": {
      "type": "integer"
    },
    "notifications": {
      "items": {
        "properties": {
          "id": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "kind": {
            "type": "string",
            "enum": [
              "failure",
              "app"
            ],
            "description": "Kind is \"failure\" (a run that failed, needs a sign-in, or was skipped\nor missed) or \"app\" (about the app, e.g. an update)."
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "routine": {
            "type": "string",
            "description": "Routine and Run (a run ID, as in `runs show`) are what it's about, if any."
          },
          "run": {
            "type": "string"
          },
          "deliveredAt": {
            "type": "string",
            "format": "date-time",
            "description": "DeliveredAt is when a frontend showed it; absent until then."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "at",
          "kind",
          "title"
        ],
        "description": "Notification is one thing to tell me."
      },
      "type": "array"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "notifications"
  ],
  "title": "Notifications",
  "description": "Written by the Go core, delivered by frontends: File is the notifications file: written and read by the core only."
}
