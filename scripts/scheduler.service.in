[Unit]
Description=__NAME__ scheduler (runs routines on their schedules)
After=network-online.target

[Service]
ExecStart=__PROGRAM__ daemon
Environment=__PATH__
Restart=always
RestartSec=30
# Stopping signals the scheduler alone, which stops its runs (and records
# them interrupted); what's left once it has exited is killed.
KillMode=mixed

[Install]
WantedBy=default.target
